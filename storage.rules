rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Sohbet görselleri ─────────────────────────────────────────────────────
    // Giriş yapmış her kullanıcı okuyabilir ve yazabilir.
    match /chat_images/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024   // maks 10 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Sunucu ikonları ───────────────────────────────────────────────────────
    match /server_icons/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024    // maks 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Profil fotoğrafları ───────────────────────────────────────────────────
    match /profile_photos/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024    // maks 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Diğer her şey varsayılan olarak kapalı ────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
