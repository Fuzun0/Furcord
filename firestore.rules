rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Kullanıcı profilleri ──────────────────────────────────────────────────
    // Herhangi bir authenticated kullanıcı kendi profilini yazabilir.
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Bildirimler: herhangi bir authenticated kullanıcı BAŞKASININ notification
      // alt-koleksiyonuna yeni belge oluşturabilir (arkadaşlık isteği, sunucu daveti).
      // Kendi bildirimlerini sadece sahibi okuyabilir/silebilir.
      match /notifications/{notifId} {
        allow create: if request.auth != null;
        allow read:   if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── DM thread'leri ───────────────────────────────────────────────────────
    // threadId formatı: "uid1_uid2" (alfabetik sıralı).
    // Her iki tarafın da UID'si threadId içinde bulunmalı.
    match /dm_threads/{threadId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in threadId.split("_");

      match /messages/{msgId} {
        allow read, write: if request.auth != null
                           && request.auth.uid in threadId.split("_");
      }
    }

    // ── Eski DM koleksiyonu (geriye dönük uyumluluk) ─────────────────────────
    match /directMessages/{channelId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in channelId.split("_");

      match /messages/{msgId} {
        allow read, write: if request.auth != null
                           && request.auth.uid in channelId.split("_");
      }
    }

    // ── Sunucular ────────────────────────────────────────────────────────────
    match /servers/{serverId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;

      match /{subCollection}/{docId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // ── Arkadaş listeleri ────────────────────────────────────────────────────
    match /friends/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;

      match /list/{friendId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Uygulama konfigürasyonu ───────────────────────────────────────────────
    match /config/{document} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Ses relay sinyalizasyonu ─────────────────────────────────────────────
    match /voiceRelay/{channelId}/{document=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

  }
}
